# Copiar como .env y reemplazar solamente los valores locales.
# No subir el archivo .env al repositorio.

DB_URL=jdbc:mariadb://localhost:3300/GymOrganization
DB_USERNAME=root
DB_PASSWORD=cambiar_por_contrasena_local
APP_ADMIN_PASSWORD=cambiar_por_contrasena_segura

# Opcional: solamente para generar datos de prueba de carga.
LOADTEST_DB_URL=jdbc:mariadb://localhost:3300/GymOrganizationLoadTest

# Opcional: base aislada para capturas y videos de presentación.
DEMO_DB_URL=jdbc:mariadb://localhost:3300/GymOrganizationDemo

# En uso normal debe permanecer en 1.
APP_MAXIMUM_SESSIONS=1
